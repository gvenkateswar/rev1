# Working files -- downloaded videos, extracted clips, cached analysis.
# Everything in work/ is derived; only source code is tracked.
work/
*.mp4
*.mkv
*.webm
*.m4a
*.wav
*.mp3

# Speaker voiceprint store -- biometric data, never committed.
# Lives at ~/.transcriber/speakers.db by default; this catches local copies.
*.db
*.sqlite3

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# Editors
.vscode/
.idea/
.DS_Store
.pytest_cache/

# Credentials. The token file lives in ~/.transcriber, not here, but a stray
# copy in the working tree must never be committable.
hf_token
*.token
.env
